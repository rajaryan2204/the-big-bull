generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String   @default("Chief Administrator")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Team {
  id                 String               @id @default(cuid())
  teamCode           String               @unique
  name               String
  accessCodeHash     String
  startingBalance    Int                  @default(5000)
  currentBalance     Int                  @default(5000)
  score              Int                  @default(0)
  correctAnswers     Int                  @default(0)
  attemptedQuestions Int                  @default(0)
  isActive           Boolean              @default(true)
  isDisabled         Boolean              @default(false)
  connectionStatus   String               @default("DISCONNECTED")
  lastSeenAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  members            String[]             @default([])
  isDisqualified     Boolean              @default(false)
  strikesCount       Int                  @default(0)
  auditLogs          AuditLog[]
  coinTransactions   CoinTransaction[]
  lifelines          LifelinePurchase[]
  suspiciousEvents   SuspiciousActivity[]
  answers            TeamAnswer[]
  sessions           TeamSession[]

  @@index([teamCode])
  @@index([isDisabled])
}

model TeamSession {
  id           String   @id @default(cuid())
  teamId       String
  sessionToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([sessionToken])
}

model Game {
  id                       String               @id @default(cuid())
  title                    String               @default("THE BIG BULL Championship")
  status                   String               @default("LOBBY")
  currentQuestionIndex     Int                  @default(0)
  correctReward            Int                  @default(1000)
  incorrectPenalty         Int                  @default(200)
  unansweredPenalty        Int                  @default(0)
  defaultQuestionDuration  Int                  @default(300)
  oneActiveSessionPerTeam  Boolean              @default(true)
  examMode                 Boolean              @default(false)
  allowAnswerChange        Boolean              @default(false)
  allowRepeatLifelines     Boolean              @default(false)
  publicLeaderboardColumns String               @default("rank,name,score,coins,correct")
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  auditLogs                AuditLog[]
  coinTransactions         CoinTransaction[]
  gameQuestions            GameQuestion[]
  lifelines                LifelinePurchase[]
  suspiciousEvents         SuspiciousActivity[]
  answers                  TeamAnswer[]
}

model Question {
  id              String         @id @default(cuid())
  text            String
  category        String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctOption   String
  imageUrl        String?
  visualClueUrl   String?
  hintText        String?
  explanation     String?
  difficulty      String         @default("MEDIUM")
  durationSeconds Int            @default(300)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  gameQuestions   GameQuestion[]

  @@index([category])
}

model GameQuestion {
  id               String             @id @default(cuid())
  gameId           String
  questionId       String
  orderIndex       Int
  durationSeconds  Int                @default(300)
  status           String             @default("PENDING")
  openedAt         DateTime?
  deadline         DateTime?
  closedAt         DateTime?
  remainingOnPause Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  game             Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  question         Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  lifelines        LifelinePurchase[]
  answers          TeamAnswer[]

  @@unique([gameId, orderIndex])
  @@unique([gameId, questionId])
  @@index([gameId])
  @@index([questionId])
}

model TeamAnswer {
  id               String       @id @default(cuid())
  gameId           String
  gameQuestionId   String
  teamId           String
  selectedOption   String
  isCorrect        Boolean?
  isLocked         Boolean      @default(true)
  pointsAwarded    Int          @default(0)
  timeTakenSeconds Float?
  submittedAt      DateTime     @default(now())
  game             Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameQuestion     GameQuestion @relation(fields: [gameQuestionId], references: [id], onDelete: Cascade)
  team             Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([gameQuestionId, teamId])
  @@index([gameId])
  @@index([teamId])
}

model LifelinePurchase {
  id             String       @id @default(cuid())
  gameId         String
  gameQuestionId String
  teamId         String
  lifelineType   String
  cost           Int
  details        String?
  idempotencyKey String       @unique
  purchasedAt    DateTime     @default(now())
  game           Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameQuestion   GameQuestion @relation(fields: [gameQuestionId], references: [id], onDelete: Cascade)
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([gameQuestionId, teamId, lifelineType])
  @@index([gameId])
  @@index([teamId])
}

model CoinTransaction {
  id                String   @id @default(cuid())
  gameId            String?
  teamId            String
  transactionType   String
  amount            Int
  previousBalance   Int
  newBalance        Int
  relatedQuestionId String?
  eventDetails      String?
  idempotencyKey    String?  @unique
  createdAt         DateTime @default(now())
  game              Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team              Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([gameId])
}

model AuditLog {
  id        String   @id @default(cuid())
  gameId    String?
  teamId    String?
  action    String
  actor     String
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([teamId])
  @@index([createdAt])
}

model SuspiciousActivity {
  id          String   @id @default(cuid())
  gameId      String?
  teamId      String
  eventType   String
  description String
  metadata    String?
  flagCount   Int      @default(1)
  createdAt   DateTime @default(now())
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([gameId])
}
