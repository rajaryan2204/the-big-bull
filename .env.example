# THE BIG BULL - Environment Configuration

# Server & Network Configuration
PORT=3000
HOST=0.0.0.0
# Base URL for QR codes and client connections. 
# For mobile testing on local Wi-Fi, set this to your local IP, e.g. http://192.168.1.100:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (PostgreSQL via Docker Compose)
DATABASE_URL=postgresql://bigbull_user:bigbull_secret@localhost:5432/bigbull_db?schema=public

# Authentication & Security
# Change these secrets for any staging or production deployment!
JWT_SECRET=big-bull-auth-token-super-secret-key-32chars-min-2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bigbull2026

# Session Security Configuration
COOKIE_NAME=bigbull_team_token
ADMIN_COOKIE_NAME=bigbull_admin_token
COOKIE_SECURE=false # Set to true in HTTPS environments

# Runtime Mode
# 'auto': Try PostgreSQL; if unreachable, gracefully use in-memory demo store with clear banner
# 'postgres': Strictly require PostgreSQL
# 'demo': Force in-memory demo store
STORAGE_MODE=auto
